<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t
        t-name="OrderReceipt"
        t-inherit="point_of_sale.OrderReceipt"
        t-inherit-mode="extension"
    >
        <xpath
            expr="//div[@t-if='order.company.point_of_sale_use_ticket_qr_code and order.finalized']"
            position="attributes"
        >
            <attribute
                name="t-if"
            >(order.company.point_of_sale_use_ticket_qr_code and order.finalized) or (order.ticket_code and (!order.config.is_simplified_config or order.to_invoice))</attribute>
        </xpath>
    </t>
</templates>
