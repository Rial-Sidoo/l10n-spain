<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <t
        t-name="TicketScreen"
        t-inherit="point_of_sale.TicketScreen"
        t-inherit-mode="extension"
    >
        <xpath
            expr="//tr[hasclass('order-row')]/td[hasclass('order-name')]"
            position="after"
        >
            <td class="align-middle">
                <div class="fw-bolder">
                    <t t-if="order.l10n_es_unique_id" t-esc="order.l10n_es_unique_id" />
                </div>
            </td>
        </xpath>
        <xpath
            expr="//div[hasclass('order-row')]/div[hasclass('order-name')]"
            position="inside"
        >
            <div t-if="order.l10n_es_unique_id" class="small text-muted">
                <t t-esc="order.l10n_es_unique_id" />
            </div>
        </xpath>
    </t>

</templates>
